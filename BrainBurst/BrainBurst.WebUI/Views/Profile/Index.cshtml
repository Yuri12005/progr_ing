@{
    ViewData["Title"] = "Мій профіль";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .profile-container {
        max-width: 800px;
        margin: 0 auto;
        text-align: center;
    }
    .profile-header {
        margin-bottom: 40px;
    }
    .profile-avatar {
        width: 120px;
        height: 120px;
        background-color: #FF3B30;
        color: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 48px;
        font-weight: 800;
        margin: 0 auto 20px auto;
        text-transform: uppercase;
    }
    .profile-name { 
        font-size: 36px; 
        font-weight: 800; 
        margin-bottom: 5px; 
        color: #000;
    }
    .profile-rank { 
        font-size: 20px; 
        color: #666; 
        margin-bottom: 25px; 
        font-weight: 600;
    }
    
    .stats-row {
        display: flex;
        justify-content: center;
        gap: 20px;
        margin-bottom: 40px;
    }
    .stat-card {
        background-color: #FFF0EF;
        border: 2px solid #FF3B30;
        border-radius: 20px;
        padding: 25px 40px;
        min-width: 180px;
    }
    .stat-value { 
        font-size: 42px; 
        font-weight: 800; 
        color: #FF3B30; 
        line-height: 1;
    }
    .stat-label { 
        font-size: 16px; 
        font-weight: 700; 
        color: #333;
        margin-top: 10px;
    }

    .btn-edit {
        background-color: #000;
        color: white;
        padding: 12px 30px;
        border-radius: 12px;
        text-decoration: none;
        font-weight: 700;
        transition: opacity 0.2s;
    }
    .btn-archive {
        display: inline-block;
        margin-top: 20px;
        color: #FF3B30;
        text-decoration: none;
        font-weight: 700;
        border: 2px solid #FF3B30;
        padding: 15px 40px;
        border-radius: 15px;
        transition: all 0.2s;
    }
    .btn-archive:hover {
        background-color: #FF3B30;
        color: white;
    }
</style>

<div class="profile-container">
    <div class="profile-header">
        @* 1. Відображаємо першу літеру імені *@
        <div class="profile-avatar">
            @(string.IsNullOrEmpty(ViewBag.Username) ? "U" : ViewBag.Username.Substring(0, 1))
        </div>
        
        @* 2. Відображаємо реальне Ім'я (замість "нікнейм") *@
        <div class="profile-name">@ViewBag.Username</div>
        
        @* 3. Відображаємо реальне Звання *@
        <div class="profile-rank">@ViewBag.Rank</div>

        <a asp-controller="Profile" asp-action="Edit" class="btn-edit">
            Редагувати профіль
        </a>
    </div>

    <div class="stats-row">
        <div class="stat-card">
            @* 4. Відображаємо реальні Бали *@
            <div class="stat-value">@ViewBag.Points</div>
            <div class="stat-label">Балів набрано</div>
        </div>
        
        @* Якщо хочеш додати кількість карток, це треба теж передавати через ViewBag, 
           але поки що залишимо тільки Бали, щоб не було помилки *@
    </div>

    <a asp-controller="Profile" asp-action="Archive" class="btn-archive">
        📜 Історія моїх тестів
    </a>
</div>